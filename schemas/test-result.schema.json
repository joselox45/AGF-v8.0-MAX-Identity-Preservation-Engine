{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKADI MTE Test Result",
  "type": "object",
  "required": [
    "test_id",
    "status",
    "reason"
  ],
  "properties": {
    "test_id": {
      "type": "string",
      "pattern": "^T(0[1-9]|1[0-9]|20)$"
    },
    "requirement_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNVERIFIED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}